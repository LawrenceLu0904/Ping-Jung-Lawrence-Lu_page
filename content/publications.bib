@inproceedings{he2026decoding,
  selected = {true},
  title = {Decoding Anatomical Structure from Neural Population Activity using Self-supervised Learning},
  author = {Tianxiao He and Malhar Patel and Chenyi Li and Anna Maslarova and Mihály Vöröslakos and Subhrajit Dey and Ping-Jung(Lawrence) Lu and Sirish Parupudi and Thiago Viegas and Nalini Ramanathan and Wei-Lun Hung and Eden Wu and Saurabh Vyas and György Buzsáki and Erdem Varol},
  year = {2026},
  booktitle = {Computational and Systems Neuroscience (Cosyne)},
  address = {Lisbon, Portugal},
  poster = {/papers/lfp2vec_cosyne_poster.pdf},
  preview = {lfp2vec_cosyne.png},
  abstract = {We study in vivo localization of recording sites in high-density probes by domain-adapting a self-supervised model to decode anatomical identity from raw local field potentials (LFP) and generalize across labs and species. We find that LFP encodes rich anatomical information, that our approach enables zero-shot transfer of brain-region decoding to new subjects and labs, and that adapting a pre-trained audio model yields generalizable embeddings across tasks. We validate across SiNAPs, Neuropixels, and non-human-primate Neuropixels datasets spanning spontaneous, visual, and motor tasks.},
  description = {Poster presented at Cosyne 2026, Lisbon. A self-supervised framework that decodes anatomical identity from raw single-channel LFP, enabling zero-shot brain-region decoding across subjects, labs, and species.},
  keywords = {Self-Supervised Learning, Electrophysiology, Neural Decoding, Local Field Potentials, Foundation Models},
}
